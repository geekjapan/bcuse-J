# Copy to .env (ignored by git). Never commit real keys.

# --policy azure: Microsoft Decision 1 in Azure Foundry. API key, or leave it empty and set a current Entra token.
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DEPLOYMENT_NAME=decision-1
AZURE_API_KEY=
AZURE_ENTRA_TOKEN=

# --policy openai: OpenAI Decisions.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna

# Text helper for Decision policies. Without it, no input operation is offered. OpenAI-compatible endpoint.
TEXT_MODEL=
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=

# --policy llm and --policy generative. OpenAI-compatible endpoint; leave LLM_BASE_URL empty for OpenAI.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Optional: a specific Cua Driver binary.
CUA_DRIVER_BIN=
